{
  "name": "@noc/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --target node26 --out-dir dist --clean --no-splitting",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "auth:generate": "npx auth@latest generate --config src/auth.ts --adapter drizzle --dialect postgresql --output src/db/auth-schema.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.1.5",
    "better-auth": "^1.7.16",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0",
    "@types/web-push": "3.6.4",
    "tsup": "8.5.1"
  }
}
