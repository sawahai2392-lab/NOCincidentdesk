# Copy this file to .env. Never commit real secrets.
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173

# Native local PostgreSQL (create role/database with scripts/setup-local-postgres.ps1)
DATABASE_URL=postgresql://nocdesk:nocdesk_local_only@127.0.0.1:5432/nocdesk

# Generate a unique value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:5173

# OAuth credentials. Configure only providers that are enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# AI credentials. This key stays on the server and must never use the VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Web Push (VAPID). Generate with the web-push CLI when push notifications are enabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noc-admin@example.com

# Optional outbound email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NOC Incident Desk <no-reply@example.com>

# File storage: local in development; s3 for an S3-compatible production provider.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
