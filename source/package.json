{
  "name": "vite-react-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-noc-incident-desk --only auth,firestore",
    "emulators:export": "firebase emulators:export ./.emulator-data",
    "deploy:firebase": "npm run build && firebase deploy --only hosting,firestore:rules,firestore:indexes",
    "test:rules:unit": "node --test tests/firestore-rules.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-noc-incident-desk --only firestore \"npm run test:rules:unit\"",
    "typecheck": "tsc --noEmit",
    "test:sla": "node --test tests/sla-notifications.test.mjs",
    "test:recovery": "node --test tests/incident-recovery.test.mjs tests/realtime-sync.test.mjs",
    "test:payload": "node --test tests/firestore-payload.test.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "motion": "^12.23.24",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "react-textarea-autosize": "^8.5.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "firebase": "13.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "firebase-tools": "15.34.2",
    "@firebase/rules-unit-testing": "6.0.0"
  }
}
