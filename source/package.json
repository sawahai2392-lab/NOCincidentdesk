{
  "name": "noc-incident-desk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.8.0"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @noc/api",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run build --workspace @noc/api && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "npm run typecheck --workspace @noc/api",
    "db:migrate": "npm run db:migrate --workspace @noc/api"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.16",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.38",
    "clsx": "2.1.1",
    "lucide-react": "0.469.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "motion": "12.23.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-textarea-autosize": "8.5.9",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.7",
    "vaul": "1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.16",
    "@types/leaflet.markercluster": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.4.0",
    "concurrently": "9.2.1",
    "postcss": "8.4.0",
    "tailwindcss": "3.4.0",
    "typescript": "6.0.0",
    "vite": "8.3.5"
  }
}
